warnings.filterwarnings('ignore')

# Version sentinel for verification
PATCH_ID = "crypto-oof-fix-v2"

class FeatureOptimizer:
    """特徵工程參數優化器 - 第2層優化 - OOF修復版"""

    def __init__(self, data_path: str, config_path: str = "configs/",
                 symbol: str = "BTCUSDT", timeframe: str = "15m",
                 scaled_config: Dict = None):
        self.data_path = Path(data_path)
        self.config_path = Path(config_path)
        self.config_path.mkdir(exist_ok=True)
        self.symbol = symbol
        self.timeframe = timeframe
        
        # 時框縮放配置需在使用前初始化
        self.scaled_config = scaled_config or {}
        
        # 使用集中日誌
        self.logger = logging.getLogger(__name__)
        self.logger.info(f"FeatureOptimizer OOF-CRYPTO-FIX PATCH_ID={PATCH_ID}")

        # 🚀 加密貨幣量化交易的KPI約束（基於市場研究）
        self.kpi_constraints = {
            'min_sharpe': float(os.getenv('L2_MIN_SHARPE', '0.8')),  # 降低最小要求
            'min_sortino': float(os.getenv('L2_MIN_SORTINO', '1.0')),
            'min_calmar': float(os.getenv('L2_MIN_CALMAR', '0.6')), 
            'min_win_rate': float(os.getenv('L2_MIN_WINRATE', '0.55')),  # 加密市場調整
            'min_profit_factor': float(os.getenv('L2_MIN_PROFIT_FACTOR', '1.2')),
            'max_drawdown': float(os.getenv('L2_MAX_DRAWDOWN', '0.30')),  # 加密波動大
            'min_total_return': float(os.getenv('L2_MIN_TOTAL_RETURN', '0.05')),
            'min_annual_return': float(os.getenv('L2_MIN_ANNUAL_RETURN', '0.20'))  # 20%起步
        }
        self.logger.info(f"🔒 Layer2 加密市場KPI約束: {self.kpi_constraints}")

        # 🚀 加密量化交易的多目標權重（保持KPI重要性）
        self.obj_weights = {
            'f1_macro': float(os.getenv('L2_WEIGHT_F1_MACRO', '0.15')),     # 15%
            'f1_weighted': float(os.getenv('L2_WEIGHT_F1_WEIGHTED', '0.15')), # 15%
            'sharpe': float(os.getenv('L2_WEIGHT_SHARPE', '0.25')),         # 25% - 主要
            'sortino': float(os.getenv('L2_WEIGHT_SORTINO', '0.10')),       # 10%
            'calmar': float(os.getenv('L2_WEIGHT_CALMAR', '0.15')),         # 15%
            'profit_factor': float(os.getenv('L2_WEIGHT_PROFIT_FACTOR', '0.15')), # 15%
            'win_rate': float(os.getenv('L2_WEIGHT_WIN_RATE', '0.05')),     # 5%
            'total_return': float(os.getenv('L2_WEIGHT_TOTAL_RETURN', '0.05')), # 5%
            'annual_return': float(os.getenv('L2_WEIGHT_ANNUAL_RETURN', '0.05')) # 5%
        }
        
        # 確保權重歸一化
        weight_sum = sum(self.obj_weights.values())
        if weight_sum > 0:
            for k in self.obj_weights:
                self.obj_weights[k] = self.obj_weights[k] / weight_sum
        
        self.logger.info(f"⚖️ Layer2 加密量化目標權重: {self.obj_weights}")

        # 多目標模式配置
        self.multi_objective_mode = False  # 暫時關閉，專注單目標優化
        self.multiobjective_metrics = ['sharpe', 'calmar', 'profit_factor', 'win_rate', 
                                      'total_return', 'annual_return', 'neg_max_drawdown']

        self.scaler = TimeFrameScaler(self.logger)
        self.results_path = Path(self.config_path) / ".." / "results" / f"{self.symbol}_{self.timeframe}"
        self.results_path = self.results_path.resolve()
        self.results_path.mkdir(parents=True, exist_ok=True)

        # 特徵開關配置
        self.flags = self._validate_flags(self._load_feature_flags())

        # 🚀 完整數據預加載
        self.logger.info("🚀 預加載OHLCV、特徵、價格序列...")
        try:
            self.ohlcv_data, self.features = self._load_and_prepare_features()
            if 'close' in self.ohlcv_data.columns:
                self.close_prices = self.ohlcv_data['close'].copy()
            else:
                raise ValueError("OHLCV數據中缺少close列")

            self.valid_data_range = (self.features.index.min(), self.features.index.max())
            self.logger.info(f"✅ 數據預加載完成: OHLCV={self.ohlcv_data.shape}, 特徵={self.features.shape}")

            # 構建全量特徵矩陣
            self.X_full = self._build_full_feature_matrix()
            self.logger.info(f"✅ 全量特徵矩陣準備: {self.X_full.shape}")

        except Exception as e:
            self.logger.error(f"❌ 數據預加載失敗: {e}")
            raise ValueError(f"初始化失敗: {e}")

    def _load_feature_flags(self) -> Dict:
        """加載特徵開關配置"""
        cfg_path = self.config_path / "feature_flags.json"
        defaults = {
            "enable_td": True,
            "enable_wyckoff": True, 
            "enable_micro": True,
            "enable_derivatives": False,
            "latency_lag": 0,
            "cv_gap": 12,
            "cv_purge": 12,
            "cv_splits": 5,
            "cv_strategy": "embargo"
        }
        
        try:
            if cfg_path.exists():
                with open(cfg_path, 'r', encoding='utf-8') as f:
                    flags = json.load(f)
                if isinstance(flags, dict):
                    defaults.update(flags)
        except Exception as e:
            self.logger.warning(f"⚠️ feature_flags讀取失敗: {e}")
        
        return defaults

    def _validate_flags(self, flags: Dict) -> Dict:
        """驗證並標準化配置"""
        try:
            flags["cv_gap"] = max(0, int(flags.get("cv_gap", 12)))
            flags["cv_purge"] = max(0, int(flags.get("cv_purge", flags["cv_gap"])))
            flags["cv_splits"] = max(2, int(flags.get("cv_splits", 5)))
            flags["enable_td"] = bool(flags.get("enable_td", True))
            flags["enable_wyckoff"] = bool(flags.get("enable_wyckoff", True))
            flags["enable_micro"] = bool(flags.get("enable_micro", True))
        except Exception:
            pass
        return flags

    def _periods_per_year(self, timeframe: Optional[str] = None) -> float:
        """根據時框計算年化係數"""
        tf = (timeframe or self.timeframe or '').lower()
        mapping = {
            '1m': 252 * 24 * 60,
            '5m': 252 * 24 * 12,
            '15m': 252 * 24 * 4,  # 你的時框
            '30m': 252 * 24 * 2,
            '1h': 252 * 24,
            '4h': 252 * 6,
            '1d': 252
        }
        return float(mapping.get(tf, 252.0 * 24 * 4))

    def _compute_oof_metrics(self, X: pd.DataFrame, y: pd.Series, classifier, lag: int) -> Dict[str, float]:
        """🚀 核心修復：使用Out-Of-Fold評估計算真實KPI，避免同數據fit+predict的虛高"""
        try:
            # 時序交叉驗證
            tscv = TimeSeriesSplit(n_splits=self.flags.get('cv_splits', 5))
            
            # 收集每折的OOF預測
            oof_predictions = np.full(len(y), fill_value=1, dtype=int)  # 默認持有
            oof_probabilities = np.zeros((len(y), 3))
            
            fold_count = 0
            for train_idx, test_idx in tscv.split(X):
                try:
                    X_train, X_test = X.iloc[train_idx], X.iloc[test_idx] 
                    y_train, y_test = y.iloc[train_idx], y.iloc[test_idx]
                    
                    # 訓練分類器
                    fold_classifier = type(classifier)(**classifier.get_params())
                    try:
                        sample_weight = self._compute_sample_weights(y_train)
                        fold_classifier.fit(X_train.values, y_train.values, sample_weight=sample_weight)
                    except (TypeError, AttributeError):
                        fold_classifier.fit(X_train.values, y_train.values)
                    
                    # OOF預測
                    fold_preds = fold_classifier.predict(X_test.values)
                    oof_predictions[test_idx] = fold_preds
                    
                    if hasattr(fold_classifier, 'predict_proba'):
                        fold_proba = fold_classifier.predict_proba(X_test.values)
                        oof_probabilities[test_idx] = fold_proba
                    
                    fold_count += 1
                except Exception as e:
                    self.logger.warning(f"⚠️ CV折{fold_count}失敗: {e}")
                    continue
            
            if fold_count == 0:
                self.logger.error("❌ 所有CV折都失敗，無法計算OOF指標")
                return {}
            
            # 🚀 基於OOF預測計算真實交易KPI
            idx = X.index
            price_series = self.close_prices.reindex(idx).ffill()
            
            # 計算實際未來收益（用於評估預測準確性）
            future_returns = price_series.pct_change(lag).shift(-lag)
            aligned_returns = future_returns.reindex(idx).fillna(0.0)
            
            # 將預測轉為持倉：{0,1,2} -> {-1,0,1}
            oof_positions = pd.Series(oof_predictions - 1, index=idx)
            
            # 計算策略收益（使用下一期收益）
            next_returns = price_series.pct_change().shift(-1).reindex(idx).fillna(0.0)
            strategy_returns = (oof_positions * next_returns).fillna(0.0)
            strategy_returns = strategy_returns.replace([np.inf, -np.inf], 0.0)
            
            if len(strategy_returns) == 0 or strategy_returns.std() == 0:
                return {}

            # 🚀 計算真實交易指標
            periods_per_year = self._periods_per_year()
            mean_ret = float(strategy_returns.mean())
            std_ret = float(strategy_returns.std())
            
            # Sharpe Ratio
            sharpe = (mean_ret / std_ret * np.sqrt(periods_per_year)) if std_ret > 1e-9 else 0.0
            
            # Sortino Ratio  
            downside = strategy_returns[strategy_returns < 0]
            downside_std = float(np.sqrt((downside ** 2).mean())) if len(downside) > 0 else 0.0
            sortino = (mean_ret * np.sqrt(periods_per_year) / downside_std) if downside_std > 1e-9 else 0.0
            
            # 資產曲線分析
            equity_curve = (strategy_returns + 1.0).cumprod()
            if len(equity_curve) > 0:
                running_max = equity_curve.cummax()
                drawdowns = 1.0 - equity_curve / (running_max + 1e-9)
                max_dd = float(drawdowns.max())
                total_return = float(equity_curve.iloc[-1] - 1.0)
            else:
                max_dd, total_return = 0.0, 0.0
            
            # 年化收益
            total_periods = len(strategy_returns)
            if total_periods > 0 and total_return > -0.99:
                annual_return = (1.0 + total_return) ** (periods_per_year / total_periods) - 1.0
            else:
                annual_return = 0.0
            
            # Calmar Ratio
            calmar = (annual_return / max_dd) if max_dd > 1e-9 else 0.0
            
            # Profit Factor
            positive_returns = strategy_returns[strategy_returns > 0]
            negative_returns = strategy_returns[strategy_returns < 0]
            gross_profit = float(positive_returns.sum()) if len(positive_returns) > 0 else 0.0
            gross_loss = float(-negative_returns.sum()) if len(negative_returns) > 0 else 0.0
            profit_factor = (gross_profit / gross_loss) if gross_loss > 1e-9 else float('inf')
            
            # Win Rate
            win_rate = float((strategy_returns > 0).mean())
            
            # 🚀 加密貨幣合理上限裁切（基於市場研究）
            metrics = {
                'f1_macro': float(f1_score(y, oof_predictions, average='macro', zero_division=0)),
                'f1_weighted': float(f1_score(y, oof_predictions, average='weighted', zero_division=0)),
                'sharpe': float(min(max(sharpe, -2.0), 5.0)),              # Sharpe: [-2, 5]
                'sortino': float(min(max(sortino, -2.0), 8.0)),            # Sortino: [-2, 8]
                'calmar': float(min(max(calmar, -5.0), 10.0)),             # Calmar: [-5, 10]
                'profit_factor': float(min(max(profit_factor, 0.0), 5.0)), # PF: [0, 5]
                'win_rate': float(min(max(win_rate, 0.0), 1.0)),           # Win Rate: [0, 1]
                'total_return': float(min(max(total_return, -0.8), 20.0)),  # Total: [-80%, 2000%]
                'annual_return': float(min(max(annual_return, -0.5), 5.0)), # Annual: [-50%, 500%]
                'max_drawdown': float(max_dd),
                'mean_return': float(mean_ret),
                'std_return': float(std_ret),
                'n_samples': float(len(X)),
                'lag': float(lag),
                'fold_count': float(fold_count)
            }
            
            self.logger.info(f"📊 OOF指標: F1_macro={metrics['f1_macro']:.3f}, "
                           f"Sharpe={metrics['sharpe']:.2f}, 年化={metrics['annual_return']:.1%}, "
                           f"勝率={metrics['win_rate']:.1%}, 回撤={metrics['max_drawdown']:.1%}")
            
            return metrics
            
        except Exception as e:
            self.logger.error(f"❌ OOF指標計算失敗: {e}")
            return {}

    def _compute_sample_weights(self, y: pd.Series) -> np.ndarray:
        """計算類別平衡權重"""
        try:
            y_series = pd.Series(y)
            value_counts = y_series.value_counts().to_dict()
            classes = sorted(value_counts.keys())
            total = float(len(y_series))
            n_classes = float(len(classes))
            
            class_to_weight = {
                c: (total / (n_classes * float(value_counts.get(c, 1)))) 
                for c in classes
            }
            return y_series.map(class_to_weight).fillna(1.0).values
        except Exception as e:
            self.logger.warning(f"樣本權重計算失敗: {e}")
            return np.ones(len(y), dtype=float)

    def _weighted_objective_score(self, metrics: Dict[str, float]) -> float:
        """加權目標分數計算（加密市場標準）"""
        if not metrics:
            return 0.0
            
        score = 0.0
        for name, weight in self.obj_weights.items():
            if weight == 0 or name not in metrics:
                continue
                
            value = metrics[name]
            if not np.isfinite(value):
                continue
                
            # 🚀 加密市場合理範圍（不過度裁切）
            if name in ('sharpe', 'sortino'):
                normalized_value = max(min(value, 5.0), -2.0)
            elif name in ('profit_factor',):
                normalized_value = max(min(value, 5.0), 0.0)
            elif name in ('annual_return', 'total_return'):
                normalized_value = max(min(value, 5.0), -0.5)  # 500%上限
            elif name in ('calmar',):
                normalized_value = max(min(value, 10.0), -5.0)
            else:
                normalized_value = value
                
            score += float(weight) * float(normalized_value)
        
        return float(score)

    def _validate_score_legitimacy(self, score: float, X: pd.DataFrame, y: pd.Series, model) -> tuple:
        """🚀 多重驗證（加密市場調整）"""
        try:
            if score < 0.7:  # 低分不需驗證
                return True, "分數正常範圍"
            
            self.logger.info(f"🔍 高分驗證開始: {score:.4f}")
            validation_failed = 0
            
            # 1. 隨機數據測試
            try:
                X_random = pd.DataFrame(np.random.randn(*X.shape), index=X.index, columns=X.columns)
                random_scores = cross_val_score(model, X_random, y, cv=TimeSeriesSplit(n_splits=3), n_jobs=-1)
                random_score = random_scores.mean()
                
                # 🚀 加密市場調整：隨機閾值稍微放寬
                if random_score > 0.45:  # 原為0.4
                    validation_failed += 1
                    self.logger.warning(f"❌ 隨機數據測試: {random_score:.3f} > 0.45")
                else:
                    self.logger.info(f"✅ 隨機數據測試通過: {random_score:.3f}")
            except Exception as e:
                self.logger.warning(f"⚠️ 隨機數據測試失敗: {e}")
            
            # 2. 標籤打亂測試
            try:
                y_shuffled = y.copy().values
                np.random.shuffle(y_shuffled)
                y_shuffled_series = pd.Series(y_shuffled, index=y.index)
                
                shuffled_scores = cross_val_score(model, X, y_shuffled_series, cv=TimeSeriesSplit(n_splits=3), n_jobs=-1)
                shuffled_score = shuffled_scores.mean()
                
                if shuffled_score > 0.45:  # 調整閾值
                    validation_failed += 1
                    self.logger.warning(f"❌ 打亂標籤測試: {shuffled_score:.3f} > 0.45")
                else:
                    self.logger.info(f"✅ 打亂標籤測試通過: {shuffled_score:.3f}")
            except Exception as e:
                self.logger.warning(f"⚠️ 打亂標籤測試失敗: {e}")
            
            # 3. 時序一致性檢查
            try:
                tscv = TimeSeriesSplit(n_splits=3)
                ts_scores = cross_val_score(model, X, y, cv=tscv, n_jobs=-1)
                ts_score = ts_scores.mean()
                score_diff = abs(score - ts_score)
                
                if score_diff > 0.20:  # 加密市場波動大，放寬差異
                    validation_failed += 1
                    self.logger.warning(f"❌ 時序一致性: 差異{score_diff:.3f} > 0.20")
                else:
                    self.logger.info(f"✅ 時序一致性通過: 差異{score_diff:.3f}")
            except Exception as e:
                self.logger.warning(f"⚠️ 時序一致性測試失敗: {e}")
            
            # 🚀 加密市場標準：允許1項驗證失敗
            if validation_failed <= 1:
                self.logger.info(f"✅ 多重驗證通過: {validation_failed}/3項失敗")
                return True, f"多重驗證通過({validation_failed}項失敗)"
            else:
                self.logger.warning(f"❌ 多重驗證失敗: {validation_failed}/3項失敗")
                return False, f"多重驗證失敗({validation_failed}項失敗)"
                
        except Exception as e:
            self.logger.error(f"❌ 驗證過程失敗: {e}")
            return True, f"驗證異常: {e}"

    def create_enhanced_classifier(self, trial: optuna.Trial, n_features: int):
        """創建增強分類器"""
        model_type = trial.suggest_categorical(
            'model_type', 
            ['random_forest', 'extra_trees', 'gradient_boosting', 'lightgbm']
        )
        
        if model_type == 'random_forest':
            return RandomForestClassifier(
                n_estimators=trial.suggest_int('rf_n_estimators', 200, 400),
                max_depth=trial.suggest_int('rf_max_depth', 8, 16),
                min_samples_split=trial.suggest_int('rf_min_samples_split', 2, 10),
                min_samples_leaf=trial.suggest_int('rf_min_samples_leaf', 1, 6),
                max_features=trial.suggest_categorical('rf_max_features', ['sqrt', 'log2']),
                random_state=42,
                n_jobs=-1,
                class_weight='balanced_subsample'
            )
        
        elif model_type == 'extra_trees':
            return ExtraTreesClassifier(
                n_estimators=trial.suggest_int('et_n_estimators', 200, 500),
                max_depth=trial.suggest_int('et_max_depth', 8, 16),
                min_samples_split=trial.suggest_int('et_min_samples_split', 5, 15),
                min_samples_leaf=trial.suggest_int('et_min_samples_leaf', 2, 10),
                max_features=trial.suggest_float('et_max_features', 0.3, 0.8),
                random_state=42,
                n_jobs=-1,
                class_weight='balanced'
            )
        
        elif model_type == 'lightgbm':
            try:
                from lightgbm import LGBMClassifier
                return LGBMClassifier(
                    objective='multiclass',
                    num_class=3,
                    n_estimators=trial.suggest_int('lgb_n_estimators', 300, 800),
                    learning_rate=trial.suggest_float('lgb_learning_rate', 0.02, 0.15),
                    max_depth=trial.suggest_int('lgb_max_depth', 4, 10),
                    num_leaves=trial.suggest_int('lgb_leaves', 15, 80),
                    subsample=trial.suggest_float('lgb_subsample', 0.6, 0.9),
                    colsample_bytree=trial.suggest_float('lgb_colsample', 0.6, 0.9),
                    class_weight='balanced',
                    random_state=42,
                    n_jobs=-1,
                    verbosity=-1
                )
            except ImportError:
                self.logger.warning("⚠️ LightGBM不可用，使用GradientBoosting")
                
        # 默認使用GradientBoosting
        return GradientBoostingClassifier(
            n_estimators=trial.suggest_int('gb_n_estimators', 150, 300),
            max_depth=trial.suggest_int('gb_max_depth', 4, 10),
            learning_rate=trial.suggest_float('gb_learning_rate', 0.05, 0.2),
            random_state=42
        )

    def _make_cv_splits(self, X: pd.DataFrame, n_splits: int = 5) -> List[Tuple[np.ndarray, np.ndarray]]:
        """創建時序交叉驗證切分（防洩漏）"""
        tscv = TimeSeriesSplit(n_splits=n_splits)
        gap = int(self.flags.get('cv_gap', 12))
        purge = int(self.flags.get('cv_purge', gap))
        
        splits = []
        for train_idx, test_idx in tscv.split(X):
            train_idx, test_idx = list(train_idx), list(test_idx)
            
            # Embargo策略：訓練集尾部purge，測試集頭部gap
            if len(train_idx) > purge:
                train_idx = train_idx[:-purge]
            if len(test_idx) > gap:
                test_idx = test_idx[gap:]
                
            if len(train_idx) > 0 and len(test_idx) > 0:
                splits.append((np.array(train_idx), np.array(test_idx)))
        
        return splits

    def generate_labels(self, price_data: pd.Series, params: Dict[str, Any]) -> pd.Series:
        """生成標籤（與Layer1對齊）"""
        try:
            lag = int(params.get('lag', 15))  # 從Layer1繼承
            profit_quantile = float(params.get('profit_quantile', params.get('buy_quantile', 0.75)))
            loss_quantile = float(params.get('loss_quantile', params.get('sell_quantile', 0.25)))
            lookback_window = int(params.get('lookback_window', 500))
            
            # 計算未來收益
            future_returns = (price_data.shift(-lag) - price_data) / price_data
            
            # 使用歷史收益計算滾動分位數（避免洩漏）
            hist_returns = future_returns.shift(1)  # 向前偏移，只用歷史
            
            rolling_upper = hist_returns.rolling(
                window=lookback_window, min_periods=100
            ).quantile(profit_quantile)
            
            rolling_lower = hist_returns.rolling(
                window=lookback_window, min_periods=100  
            ).quantile(loss_quantile)
            
            # 標籤分配
            labels = pd.Series(1, index=price_data.index, dtype=int)
            
            valid_start = lookback_window
            valid_end = len(future_returns) - lag if lag > 0 else len(future_returns)
            
            if valid_start < valid_end:
                valid_slice = slice(valid_start, valid_end)
                
                # 買入信號
                buy_mask = future_returns.iloc[valid_slice] > rolling_upper.iloc[valid_slice]
                valid_indices = price_data.index[valid_slice]
                labels.loc[valid_indices[buy_mask.values]] = 2
                
                # 賣出信號  
                sell_mask = future_returns.iloc[valid_slice] < rolling_lower.iloc[valid_slice]
                labels.loc[valid_indices[sell_mask.values]] = 0
            
            # 移除未來洩漏
            if lag > 0:
                labels = labels[:-lag]
                
            return labels.dropna()
            
        except Exception as e:
            self.logger.error(f"標籤生成失敗: {e}")
            return pd.Series([], dtype=int)

    def objective(self, trial: optuna.Trial) -> float:
        """🚀 修復版目標函數：OOF評估 + 加密市場標準"""
        try:
            # 讀取Layer1參數實現聯動
            layer1_params = None
            try:
                tf_config = self.config_path / f"label_params_{self.timeframe}.json"
                if tf_config.exists():
                    with open(tf_config, 'r', encoding='utf-8') as f:
                        layer1_result = json.load(f)
                        layer1_params = layer1_result.get('best_params', {})
                        self.logger.info(f"🔗 Layer1聯動: lag={layer1_params.get('lag', 'N/A')}")
            except Exception as e:
                self.logger.warning(f"無法讀取Layer1結果: {e}")
            
            # 🚀 Layer1聯動：lag必須對齊
            if layer1_params and 'lag' in layer1_params:
                lag = int(layer1_params['lag'])  # 強制使用Layer1的lag
                self.logger.info(f"🔗 強制對齊lag={lag}")
            else:
                lag = trial.suggest_int('lag', 12, 18)  # 回退範圍
            
            # 標籤參數（基於Layer1結果微調）
            if layer1_params:
                l1_buy_q = float(layer1_params.get('buy_quantile', 0.75))
                l1_sell_q = float(layer1_params.get('sell_quantile', 0.25))
                
                # 在Layer1結果附近小幅調整
                profit_quantile = trial.suggest_float('profit_quantile', 
                                                    max(0.65, l1_buy_q - 0.05), 
                                                    min(0.85, l1_buy_q + 0.05))
                loss_quantile = trial.suggest_float('loss_quantile',
                                                  max(0.15, l1_sell_q - 0.05),
                                                  min(0.35, l1_sell_q + 0.05))
            else:
                profit_quantile = trial.suggest_float('profit_quantile', 0.70, 0.80)
                loss_quantile = trial.suggest_float('loss_quantile', 0.20, 0.30)
            
            lookback_window = trial.suggest_int('lookback_window', 400, 600)
            
            # 生成標籤
            labels = self.generate_labels(
                self.close_prices,
                {
                    'lag': lag,
                    'profit_quantile': profit_quantile,
                    'loss_quantile': loss_quantile,
                    'lookback_window': lookback_window
                }
            )
            
            if len(labels) < 1000:
                return 0.0
            
            # 數據對齊
            common_idx = self.X_full.index.intersection(labels.index)
            X = self.X_full.reindex(common_idx).fillna(0)
            y = labels.reindex(common_idx).astype(int)
            
            if len(X) < 1000:
                return 0.0
            
            # 特徵選擇
            n_features = len(X.columns)
            coarse_k = trial.suggest_int('coarse_k', 
                                       max(30, int(n_features * 0.4)),
                                       min(n_features-1, int(n_features * 0.7)))
            fine_k = trial.suggest_int('fine_k',
                                     max(15, int(coarse_k * 0.3)), 
                                     min(coarse_k-1, int(coarse_k * 0.6)))
            
            # 執行特徵選擇
            selected_features = self._select_features(X, y, coarse_k, fine_k)
            if len(selected_features) < 10:
                return 0.0
                
            X_selected = X[selected_features]
            
            # 🚀 核心修復：使用OOF評估替代同數據評估
            classifier = self.create_enhanced_classifier(trial, len(selected_features))
            oof_metrics = self._compute_oof_metrics(X_selected, y, classifier, lag)
            
            if not oof_metrics:
                return 0.0
            
            # CV基礎分數（交叉驗證F1）
            try:
                cv_scores = cross_val_score(
                    classifier, X_selected, y,
                    cv=self._make_cv_splits(X_selected),
                    scoring='f1_weighted',
                    n_jobs=-1
                )
                cv_base_score = cv_scores.mean()
            except Exception as e:
                self.logger.warning(f"CV評分失敗: {e}")
                cv_base_score = 0.0
            
            # 🚀 加密量化評分：平衡ML準確性與交易KPI
            kpi_score = self._weighted_objective_score(oof_metrics)
            final_score = cv_base_score * 0.4 + kpi_score * 0.6  # 保持KPI重要性
            
            # 高分驗證（加密市場標準）
            if final_score > 0.8:  # 加密市場高分門檻提高
                is_valid, msg = self._validate_score_legitimacy(cv_base_score, X_selected, y, classifier)
                if not is_valid:
                    self.logger.warning(f"⚠️ 高分驗證失敗: {msg}")
                    final_score *= 0.85  # 輕微懲罰，不完全否定
                else:
                    self.logger.info(f"✅ 高分驗證通過: {msg}")
            
            # 記錄trial信息
            trial.set_user_attr('selected_features', selected_features)
            trial.set_user_attr('cv_base_score', cv_base_score)
            trial.set_user_attr('oof_metrics', oof_metrics)
            trial.set_user_attr('kpi_score', kpi_score)
            
            self.logger.info(f"📊 Trial {trial.number}: CV={cv_base_score:.3f}, "
                           f"KPI={kpi_score:.3f}, 最終={final_score:.4f}")
            self.logger.info(f"   OOF Sharpe={oof_metrics.get('sharpe', 0):.2f}, "
                           f"年化={oof_metrics.get('annual_return', 0):.1%}")
            
            return final_score
            
        except Exception as e:
            self.logger.error(f"❌ 目標函數執行失敗: {e}")
            return 0.0

    def _select_features(self, X: pd.DataFrame, y: pd.Series, coarse_k: int, fine_k: int) -> List[str]:
        """特徵選擇流程"""
        try:
            # 方差過濾
            variance_selector = VarianceThreshold(threshold=0.01)
            variance_selector.fit(X)
            cols_var = X.columns[variance_selector.get_support()].tolist()
            
            if len(cols_var) <= coarse_k:
                return cols_var
            
            # 粗選
            coarse_selector = SelectKBest(f_classif, k=min(coarse_k, len(cols_var)-1))
            coarse_selector.fit(X[cols_var], y)
            cols_coarse = [cols_var[i] for i in coarse_selector.get_support(indices=True)]
            
            if len(cols_coarse) <= fine_k:
                return cols_coarse
            
            # 精選
            fine_selector = SelectKBest(mutual_info_classif, k=min(fine_k, len(cols_coarse)-1))
            fine_selector.fit(X[cols_coarse], y)
            cols_fine = [cols_coarse[i] for i in fine_selector.get_support(indices=True)]
            
            # 去冗餘
            if len(cols_fine) > 1:
                final_cols = self._remove_correlated_features(X[cols_fine], threshold=0.95)
                return final_cols if final_cols else cols_fine
            
            return cols_fine
            
        except Exception as e:
            self.logger.error(f"特徵選擇失敗: {e}")
            return list(X.columns)[:min(20, len(X.columns))]

    def _remove_correlated_features(self, X: pd.DataFrame, threshold: float = 0.95) -> List[str]:
        """移除高相關特徵"""
        try:
            if X.shape[1] <= 1:
                return list(X.columns)
            
            corr_matrix = X.corr().abs()
            upper_tri = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))
            
            to_drop = set()
            for col in upper_tri.columns:
                high_corr = upper_tri.index[upper_tri[col] > threshold].tolist()
                if high_corr:
                    # 保留方差大的
                    variances = {feat: X[feat].var() for feat in high_corr + [col] if feat not in to_drop}
                    if variances:
                        keep = max(variances, key=variances.get)
                        for feat in high_corr:
                            if feat != keep:
                                to_drop.add(feat)
            
            return [col for col in X.columns if col not in to_drop]
            
        except Exception as e:
            self.logger.warning(f"去相關失敗: {e}")
            return list(X.columns)

    def optimize(self, n_trials: int = 250) -> Dict:
        """執行特徵優化"""
        self.logger.info(f"🚀 開始Layer2特徵優化: {n_trials} trials (OOF修復版)")
        
        if len(self.features) == 0:
            raise ValueError("特徵數據為空")
        
        # 創建優化研究
        study = optuna.create_study(
            direction='maximize',
            study_name=f'feature_optimization_layer2_{self.timeframe}_oof_fixed',
            pruner=optuna.pruners.MedianPruner(n_warmup_steps=10)
        )
        
        # 執行優化
        study.optimize(self.objective, n_trials=n_trials)
        
        # 收集結果
        best_trial = study.best_trial
        best_params = study.best_params
        best_score = study.best_value
        
        # 提取trial屬性
        selected_features = best_trial.user_attrs.get('selected_features', [])
        cv_base_score = best_trial.user_attrs.get('cv_base_score', 0.0)
        oof_metrics = best_trial.user_attrs.get('oof_metrics', {})
        kpi_score = best_trial.user_attrs.get('kpi_score', 0.0)
        
        # 添加必要信息到best_params
        best_params['selected_features'] = selected_features
        best_params['cv_base_score'] = cv_base_score
        best_params['oof_metrics'] = oof_metrics
        best_params['kpi_score'] = kpi_score
        
        self.logger.info(f"🎯 Layer2優化完成!")
        self.logger.info(f"   最佳分數: {best_score:.4f}")
        self.logger.info(f"   CV基礎分: {cv_base_score:.4f}")  
        self.logger.info(f"   OOF Sharpe: {oof_metrics.get('sharpe', 0):.2f}")
        self.logger.info(f"   OOF年化: {oof_metrics.get('annual_return', 0):.1%}")
        self.logger.info(f"   選中特徵: {len(selected_features)}")
        
        return {
            'timeframe': self.timeframe,
            'best_params': best_params,
            'best_score': best_score,
            'n_trials': n_trials,
            'cv_base_score': cv_base_score,
            'oof_metrics': oof_metrics,
            'selected_features': selected_features,
            'optimization_history': [
                {'trial': i, 'score': trial.value}
                for i, trial in enumerate(study.trials) 
                if trial.value is not None
            ]
        }

    def apply_transform(self, data: pd.DataFrame, params: Dict[str, Any]) -> pd.DataFrame:
        """應用特徵變換"""
        if 'label' not in data.columns:
            raise ValueError("需要包含label欄位")
        
        selected_features = params.get('selected_features', [])
        if not selected_features:
            raise ValueError("參數缺少selected_features")
            
        # 重建特徵
        try:
            X_all = self._build_full_feature_matrix()
            available_features = [f for f in selected_features if f in X_all.columns]
            
            if len(available_features) < len(selected_features):
                missing = set(selected_features) - set(available_features)
                self.logger.warning(f"⚠️ 特徵缺失: {missing}")
            
            result = data.copy()
            if available_features:
                feature_data = X_all.reindex(data.index)[available_features].fillna(0)
                result = pd.concat([result, feature_data], axis=1)
            
            return result
            
        except Exception as e:
            self.logger.error(f"特徵應用失敗: {e}")
            return data

    # 以下是必要的輔助函數（簡化版本）
    def _load_and_prepare_features(self) -> Tuple[pd.DataFrame, pd.DataFrame]:
        """加載並準備特徵"""
        try:
            # 優先使用清洗數據
            cleaned_candidates = [
                self.data_path / "processed" / "cleaned" / f"{self.symbol}_{self.timeframe}" / "cleaned_ohlcv.parquet",
                self.config_path / f"cleaned_ohlcv_{self.timeframe}.parquet"
            ]
            
            ohlcv_data = None
            for candidate in cleaned_candidates:
                if candidate.exists():
                    try:
                        ohlcv_data = read_dataframe(candidate)
                        self.logger.info(f"✅ 使用清洗數據: {candidate}")
                        break
                    except Exception:
                        continue
            
            # 回退到原始數據
            if ohlcv_data is None:
                raw_file = self.data_path / "raw" / self.symbol / f"{self.symbol}_{self.timeframe}_ohlcv.parquet"
                if raw_file.exists():
                    ohlcv_data = read_dataframe(raw_file)
                    self.logger.info(f"✅ 使用原始數據: {raw_file}")
                else:
                    raise FileNotFoundError("找不到OHLCV數據")
            
            # 生成基礎特徵
            features = self._generate_basic_features(ohlcv_data)
            
            return ohlcv_data, features
            
        except Exception as e:
            self.logger.error(f"數據加載失敗: {e}")
            raise

    def _generate_basic_features(self, ohlcv: pd.DataFrame) -> pd.DataFrame:
        """生成基礎技術特徵"""
        features = pd.DataFrame(index=ohlcv.index)
        
        # 基本價格特徵
        close = ohlcv['close']
        features['returns'] = close.pct_change().fillna(0)
        features['high_low_ratio'] = ohlcv['high'] / ohlcv['low']
        
        # 移動平均
        for window in [5, 10, 20, 50]:
            sma = close.rolling(window).mean()
            features[f'sma_{window}'] = sma
            features[f'sma_ratio_{window}'] = close / sma
        
        # RSI
        for window in [14, 21]:
            delta = close.diff()
            gain = delta.where(delta > 0, 0).rolling(window).mean()
            loss = (-delta.where(delta < 0, 0)).rolling(window).mean()
            rs = gain / (loss + 1e-9)
            features[f'rsi_{window}'] = 100 - (100 / (1 + rs))
        
        # 布林帶
        sma_20 = close.rolling(20).mean()
        std_20 = close.rolling(20).std()
        features['bb_upper'] = sma_20 + 2 * std_20
        features['bb_lower'] = sma_20 - 2 * std_20
        features['bb_position'] = (close - features['bb_lower']) / (features['bb_upper'] - features['bb_lower'])
        
        # 成交量特徵
        volume = ohlcv['volume']
        features['volume_ratio'] = volume / volume.rolling(20).mean()
        features['price_volume'] = close * volume
        
        # MACD
        ema12 = close.ewm(span=12).mean()
        ema26 = close.ewm(span=26).mean()
        features['macd'] = ema12 - ema26
        features['macd_signal'] = features['macd'].ewm(span=9).mean()
        
        return features.fillna(method='ffill').fillna(0)

    def _build_full_feature_matrix(self) -> pd.DataFrame:
        """構建完整特徵矩陣"""
        try:
            X = self.features.copy()
            
            # 添加多時框特徵（1h）
            if self.timeframe == '15m':
                mtf_features = self._generate_mtf_features()
                if not mtf_features.empty:
                    X = self._safe_merge(X, mtf_features)
            
            # 清理特徵
            X = X.fillna(method='ffill').fillna(0)
            X = X.replace([np.inf, -np.inf], 0)
            
            return X.astype('float32')
            
        except Exception as e:
            self.logger.error(f"特徵矩陣構建失敗: {e}")
            return self.features.copy()

    def _generate_mtf_features(self) -> pd.DataFrame:
        """生成1h多時框特徵（嚴格防洩漏）"""
        try:
            # 嘗試讀取1h數據
            h1_file = self.data_path / "raw" / self.symbol / f"{self.symbol}_1h_ohlcv.parquet"
            if not h1_file.exists():
                return pd.DataFrame()
            
            h1_data = read_dataframe(h1_file)
            
            # 生成1h技術指標
            h1_features = self._generate_basic_features(h1_data)
            
            # 🚀 關鍵：嚴格前向對齊，避免洩漏
            h1_features_shifted = h1_features.shift(1).fillna(method='ffill')  # shift(1)避免當期洩漏
            h1_aligned = h1_features_shifted.reindex(self.ohlcv_data.index, method='ffill').fillna(0)
            
            # 添加前綴
            h1_aligned = h1_aligned.add_prefix('1h_')
            
            self.logger.info(f"✅ 1h多時框特徵生成: {h1_aligned.shape[1]}個特徵，已shift(1)防洩漏")
            return h1_aligned
            
        except Exception as e:
            self.logger.warning(f"⚠️ 多時框特徵失敗: {e}")
            return pd.DataFrame()

    def _safe_merge(self, base: pd.DataFrame, extra: pd.DataFrame) -> pd.DataFrame:
        """安全合併特徵"""
        if extra is None or extra.empty:
            return base
        try:
            extra_aligned = extra.reindex(base.index).fillna(method='ffill').fillna(0)
            merged = pd.concat([base, extra_aligned], axis=1)
            return merged.loc[:, ~merged.columns.duplicated()]
        except Exception as e:
            self.logger.warning(f"特徵合併失敗: {e}")
            return base

def main():
    """主函數"""
    optimizer = FeatureOptimizer(data_path='../data', config_path='../configs')
    result = optimizer.optimize(n_trials=250)
    print(f"✅ Layer2優化完成: {result['best_score']:.4f}")

if __name__ == "__main__":
    main()
